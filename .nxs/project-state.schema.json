{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-ai.dev/schemas/project-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "repository", "execution", "current_phase", "completed_phases", "active_phase", "blocked_phases", "next_allowed_execution", "last_updated_at"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "product": {"type": "object", "additionalProperties": false, "required": ["name", "vendor", "prefix"], "properties": {"name": {"const": "Nexus AI"}, "vendor": {"const": "DevOps Solutions IA"}, "prefix": {"const": "NXS"}}},
    "repository": {"type": "object", "additionalProperties": false, "required": ["name", "canonical_branch", "remote"], "properties": {"name": {"const": "nexus-ai"}, "canonical_branch": {"const": "main"}, "remote": {"type": "string", "minLength": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["protocol_version", "mode"], "properties": {"protocol_version": {"const": "1.0.0"}, "mode": {"const": "CONTROLLED"}}},
    "current_phase": {"$ref": "#/$defs/phaseSummary"},
    "completed_phases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^NXS-P[0-9]{2}$"}},
    "active_phase": {"type": ["string", "null"], "pattern": "^NXS-P[0-9]{2}$"},
    "blocked_phases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^NXS-P[0-9]{2}$"}},
    "next_allowed_execution": {"type": "object", "additionalProperties": false, "required": ["phase", "condition"], "properties": {"phase": {"type": ["string", "null"], "pattern": "^NXS-P[0-9]{2}$"}, "condition": {"enum": ["ACTIVE_PHASE_ONLY", "DEPENDENCIES_READY", "NONE"]}}},
    "last_updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {"phaseSummary": {"type": "object", "additionalProperties": false, "required": ["id", "status", "decision", "branch", "implementation_commit", "closure_commit"], "properties": {
    "id": {"type": "string", "pattern": "^NXS-P[0-9]{2}$"}, "status": {"enum": ["PLANNED", "READY_TO_EXECUTE", "BUILDING", "VALIDATING", "FAILED", "BLOCKED", "READY"]}, "decision": {"enum": ["PENDING", "GO", "NO_GO"]}, "branch": {"type": "string", "minLength": 1}, "implementation_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "closure_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
  }}}
}
